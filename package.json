{
  "name": "zion-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mobile": "vite --config apps/mobile-client/vite.config.ts",
    "build": "vite build",
    "build:mobile": "vite build --config apps/mobile-client/vite.config.ts",
    "build:all": "npm run build && npm run build:mobile",
    "plugin:package:byteintl-model": "node scripts/package-byteintl-model-plugin.mjs",
    "plugin:package:identity": "node scripts/package-identity-plugin.mjs",
    "plugin:install:runtime": "node scripts/install-runtime-plugin.mjs",
    "preview": "vite preview --port 5175",
    "test": "vitest",
    "test:mobile": "vitest run --config apps/mobile-client/vitest.config.ts",
    "test:ui": "vitest --ui",
    "runtime:build": "npm --prefix packages/runtime run build",
    "runtime:access": "npm --prefix apps/runtime run access --",
    "runtime:chat": "npm --prefix apps/runtime run chat --",
    "runtime:cli": "npm --prefix apps/runtime run cli --",
    "remote:start": "node apps/runtime/src/remote-launcher.mjs",
    "deploy:configure": "node scripts/configure-runtime-deployment.mjs",
    "runtime:test": "npm --prefix packages/runtime test && npm --prefix packages/node-protocol test && npm --prefix apps/runtime test && npm --prefix apps/device-connector test && vitest run tests/runtime-zion-compatibility.test.ts",
    "runtime:serve": "npm run runtime:build && npm --prefix apps/runtime run start --",
    "device:connect": "node apps/device-connector/src/main.mjs",
    "device:migrate-origin": "node scripts/migrate-device-connector-origin.mjs",
    "lint": "eslint src extensions --ext .ts,.js",
    "lint:fix": "eslint src extensions --ext .ts,.js --fix"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.7",
    "@codemirror/commands": "^6.3.3",
    "@codemirror/lang-json": "^6.0.0",
    "@codemirror/lang-markdown": "^6.2.4",
    "@codemirror/language": "^6.10.2",
    "@codemirror/language-data": "^6.3.1",
    "@codemirror/search": "^6.5.0",
    "@codemirror/state": "^6.4.1",
    "@codemirror/theme-one-dark": "^6.0.0",
    "@codemirror/view": "^6.24.0",
    "@hocuspocus/provider": "^4.6.0",
    "@hocuspocus/server": "^4.6.0",
    "@replit/codemirror-minimap": "^0.5.2",
    "@replit/codemirror-vim": "^6.3.0",
    "@tanstack/react-query": "^5.102.8",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "diff": "^9.0.0",
    "diff2html": "^3.4.56",
    "eventemitter3": "^5.0.1",
    "eventsource-parser": "^4.1.0",
    "jszip": "^3.10.1",
    "katex": "^0.16.9",
    "lucide-react": "^0.468.0",
    "match-sorter": "^8.3.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mermaid": "^10.9.1",
    "micromark-extension-gfm": "^3.0.0",
    "monaco-editor": "^0.55.1",
    "plantuml-encoder": "^1.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.3",
    "remark-gfm": "^4.0.1",
    "werift": "^0.24.4",
    "ws": "^8.21.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "xterm-addon-web-links": "^0.9.0",
    "y-codemirror.next": "^0.3.6",
    "y-indexeddb": "^9.0.12",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^9.18.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^5.4.10",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.61.0"
  }
}
