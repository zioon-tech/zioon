        {
          "id": "dev.srp.revertAllFiles",
          "title": "Revert in granted files"
        }
      ],
      "keybindings": []
    },
    "activationEvents": [
      "onStartupFinished"
    ],
    "engines": {
      "zion": ">=1.0.0"
