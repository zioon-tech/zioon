{
  "name": "dev.search-replace-plus",
  "version": "0.0.2",
  "description": "Add batch accept, revert, and diff workflows to search and replace.",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.search-replace-plus",
    "name": "Search/Replace Plus",
    "version": "0.0.2",
    "main": "./main.js",
    "presentation": {
      "displayName": {
        "zh-CN": "搜索替换增强",
        "en-US": "Search/Replace Plus"
      },
      "description": {
        "zh-CN": "提供批量接受、回滚和 diff 等增强搜索替换操作。",
        "en-US": "Add batch accept, revert, and diff workflows to search and replace."
      },
      "icon": "replace-all",
      "category": "editor",
      "features": {
        "zh-CN": [
          "提供批量接受、回滚和 diff 等增强搜索替换操作。"
        ],
        "en-US": [
          "Add batch accept, revert, and diff workflows to search and replace."
        ]
      }
    },
    "nameKey": "dev.plugins.pluginName.dev.search-replace-plus",
    "descriptionKey": "dev.plugins.pluginDescription.dev.search-replace-plus",
    "contributes": {
      "commands": [
        {
          "id": "dev.srp.acceptAll",
          "title": "Accept all Search/Replace blocks",
          "titleKey": "dev.search-replace-plus.cmd.acceptAll",
          "categoryKey": "dev.search-replace-plus.category.srp"
        },
        {
          "id": "dev.srp.revertAll",
          "title": "Revert all Search/Replace blocks",
          "titleKey": "dev.search-replace-plus.cmd.revertAll",
          "categoryKey": "dev.search-replace-plus.category.srp"
        },
        {
          "id": "dev.srp.toggleDiffAll",
          "title": "Toggle Diff (all blocks)",
          "titleKey": "dev.search-replace-plus.cmd.toggleDiffAll",
          "categoryKey": "dev.search-replace-plus.category.srp"
        },
        {
          "id": "dev.srp.acceptAllFiles",
          "title": "Accept in granted files",
          "titleKey": "dev.search-replace-plus.cmd.acceptAllFiles",
          "categoryKey": "dev.search-replace-plus.category.srp"
        },
        {
          "id": "dev.srp.revertAllFiles",
          "title": "Revert in granted files",
          "titleKey": "dev.search-replace-plus.cmd.revertAllFiles",
          "categoryKey": "dev.search-replace-plus.category.srp"
        }
      ],
      "keybindings": []
    },
    "activationEvents": [
      "onStartupFinished"
    ],
    "engines": {
      "zion": ">=1.0.0"
    }
  }
