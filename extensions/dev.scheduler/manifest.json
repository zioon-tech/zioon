{
  "name": "dev.scheduler",
  "version": "0.1.0",
  "description": "Local-only scheduled Agent tasks with run history",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.scheduler",
    "name": "Scheduled Tasks",
    "version": "0.1.0",
