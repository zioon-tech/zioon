{
  "name": "dev.session-manager",
  "version": "0.0.4",
  "description": "Manage session lists, folders, import/export, cloning, and switching.",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.session-manager",
    "name": "Session Manager",
    "version": "0.0.4",
    "main": "./main.js",
    "entries": {
      "ui": "./main.js",
      "runtime": "./runtime.js"
    },
    "runtime": {
      "apiVersion": 2
    },
    "presentation": {
      "displayName": {
        "zh-CN": "会话管理器",
        "en-US": "Session Manager"
      },
      "description": {
        "zh-CN": "管理会话列表、文件夹、导入导出、克隆和切换。",
        "en-US": "Manage session lists, folders, import/export, cloning, and switching."
      },
      "icon": "messages-square",
      "category": "workspace",
      "features": {
        "zh-CN": [
          "组织和搜索会话",
          "导入、导出和克隆会话",
          "管理多面板中的活动会话"
        ],
        "en-US": [
          "Organize and search sessions",
          "Import, export, and clone sessions",
          "Manage active sessions across panels"
        ]
      },
      "permissions": [
        {
          "id": "session-data",
          "label": {
            "zh-CN": "会话数据",
            "en-US": "Session data"
          },
          "description": {
            "zh-CN": "读取、创建和更新本地会话。",
            "en-US": "Read, create, and update local sessions."
          }
        }
      ],
      "entrypoints": [
        {
          "title": {
            "zh-CN": "显示会话",
            "en-US": "Show Sessions"
          },
          "command": "zion.sessions.showPanel",
          "icon": "messages-square"
        }
      ]
    },
    "contributes": {
      "commands": [
        {
          "id": "zion.sessions.restoreCollaborationDraft",
          "title": "恢复本地草稿为新会话",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.new",
          "title": "New Session",
          "titleKey": "dev.session-manager.cmd.new",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.newInFolder",
          "title": "New Session in Folder",
          "titleKey": "dev.session-manager.cmd.newInFolder",
          "description": "Choose a target folder and create a new session",
          "descriptionKey": "dev.session-manager.cmd.newInFolder.description",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.saveAsNew",
          "title": "Save As New Session",
          "titleKey": "dev.session-manager.cmd.saveAsNew",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.rename",
          "title": "Rename Session",
          "titleKey": "dev.session-manager.cmd.rename",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.renameInline",
          "title": "Rename Session",
          "titleKey": "dev.session-manager.cmd.rename",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.autoRename",
          "title": "AI Rename Session",
          "titleKey": "dev.session-manager.cmd.autoRename",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.delete",
          "title": "Delete Session",
          "titleKey": "dev.session-manager.cmd.delete",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.switch",
          "title": "Switch Session",
          "titleKey": "dev.session-manager.cmd.switch",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.clone",
          "title": "Clone Session",
          "titleKey": "dev.session-manager.cmd.clone",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.export",
          "title": "Export Sessions",
          "titleKey": "dev.session-manager.cmd.export",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.import",
          "title": "Import Sessions",
          "titleKey": "dev.session-manager.cmd.import",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.showPanel",
          "title": "Show Sessions Panel",
          "titleKey": "dev.session-manager.cmd.showPanel",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.showSidebar",
          "title": "Show Sessions Sidebar",
          "titleKey": "dev.session-manager.cmd.showSidebar",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.hideSidebar",
          "title": "Hide Sessions Sidebar",
          "titleKey": "dev.session-manager.cmd.hideSidebar",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.toggleSidebar",
          "title": "Toggle Sessions Sidebar",
          "titleKey": "dev.session-manager.cmd.toggleSidebar",
          "categoryKey": "dev.session-manager.category.sessions"
        }
      ],
      "keybindings": [
        {
          "command": "zion.sessions.new",
          "key": "Mod-Shift-n"
        },
        {
          "command": "zion.sessions.toggleSidebar",
          "key": "Mod-Shift-s"
        },
        {
          "command": "zion.sessions.autoRename",
          "key": "Mod-r"
        },
        {
          "command": "zion.sessions.renameInline",
          "key": "Mod-Shift-r"
        }
      ]
    },
    "activationEvents": [
      "onStartupFinished",
      "onCommand:zion.sessions.showPanel",
      "onCommand:zion.sessions.toggleSidebar",
      "onCommand:zion.sessions.rename",
      "onCommand:zion.sessions.renameInline",
      "onCommand:zion.sessions.autoRename"
    ],
    "engines": {
      "zion": ">=1.0.0"
    },
    "nameKey": "dev.plugins.pluginName.dev.session-manager",
    "descriptionKey": "dev.plugins.pluginDescription.dev.session-manager"
  }
}
