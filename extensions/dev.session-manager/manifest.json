{
  "name": "dev.session-manager",
  "version": "0.0.1",
  "description": "Zion Next Plugin: dev.session-manager",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.session-manager",
    "name": "dev.session-manager",
    "version": "0.0.1",
    "main": "./main.js",
    "contributes": {
      "commands": [
        {
          "id": "zion.sessions.new",
          "title": "New Session",
          "titleKey": "dev.session-manager.cmd.new",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.saveAsNew",
          "title": "Save As New Session",
          "titleKey": "dev.session-manager.cmd.saveAsNew",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.rename",
          "title": "Rename Session",
          "titleKey": "dev.session-manager.cmd.rename",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.delete",
          "title": "Delete Session",
          "titleKey": "dev.session-manager.cmd.delete",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.switch",
          "title": "Switch Session",
          "titleKey": "dev.session-manager.cmd.switch",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.clone",
          "title": "Clone Session",
          "titleKey": "dev.session-manager.cmd.clone",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.export",
          "title": "Export Sessions",
          "titleKey": "dev.session-manager.cmd.export",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.import",
          "title": "Import Sessions",
          "titleKey": "dev.session-manager.cmd.import",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.showPanel",
          "title": "Show Sessions Panel",
          "titleKey": "dev.session-manager.cmd.showPanel",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.showSidebar",
          "title": "Show Sessions Sidebar",
          "titleKey": "dev.session-manager.cmd.showSidebar",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.hideSidebar",
          "title": "Hide Sessions Sidebar",
          "titleKey": "dev.session-manager.cmd.hideSidebar",
          "categoryKey": "dev.session-manager.category.sessions"
        },
        {
          "id": "zion.sessions.toggleSidebar",
          "title": "Toggle Sessions Sidebar",
          "titleKey": "dev.session-manager.cmd.toggleSidebar",
          "categoryKey": "dev.session-manager.category.sessions"
        }
      ],
      "keybindings": [
        {
          "command": "zion.sessions.new",
          "key": "Mod-Shift-n"
        },
        {
          "command": "zion.sessions.toggleSidebar",
          "key": "Mod-Shift-s"
        },
        {
          "command": "zion.sessions.rename",
          "key": "Mod-Shift-r"
        }
      ]
    },
    "activationEvents": [
      "onStartupFinished",
      "onCommand:zion.sessions.showPanel",
      "onCommand:zion.sessions.toggleSidebar",
      "onCommand:zion.sessions.rename"
    ],
    "engines": {
      "zion": ">=1.0.0"
    }
  }
}
