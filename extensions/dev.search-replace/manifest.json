{
  "name": "dev.search-replace",
  "version": "0.1.0",
  "description": "Zion Next Plugin: dev.search-replace",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.search-replace",
    "name": "dev.search-replace",
    "version": "0.1.0",
    "main": "./main.js",
    "contributes": {
      "commands": [
        {
          "id": "searchReplace.show",
          "title": "Show Search",
          "titleKey": "dev.search-replace.cmd.show",
          "categoryKey": "dev.search-replace.category.search"
        },
        {
          "id": "searchReplace.showWithReplace",
          "title": "Show Search and Replace",
          "titleKey": "dev.search-replace.cmd.showWithReplace",
          "categoryKey": "dev.search-replace.category.search"
        },
        {
          "id": "searchReplace.hide",
          "title": "Hide Search",
          "titleKey": "dev.search-replace.cmd.hide",
          "categoryKey": "dev.search-replace.category.search"
        },
        {
          "id": "searchReplace.next",
          "title": "Next Match",
          "titleKey": "dev.search-replace.cmd.next",
          "categoryKey": "dev.search-replace.category.search"
        },
        {
          "id": "searchReplace.prev",
          "title": "Previous Match",
          "titleKey": "dev.search-replace.cmd.prev",
          "categoryKey": "dev.search-replace.category.search"
        },
        {
          "id": "searchReplace.selectAll",
          "title": "Select All Matches",
          "titleKey": "dev.search-replace.cmd.selectAll",
          "categoryKey": "dev.search-replace.category.search"
        },
        {
          "id": "searchReplace.replace",
          "title": "Replace Current Match",
          "titleKey": "dev.search-replace.cmd.replace",
          "categoryKey": "dev.search-replace.category.search"
        },
        {
          "id": "searchReplace.replaceAll",
          "title": "Replace All Matches",
          "titleKey": "dev.search-replace.cmd.replaceAll",
          "categoryKey": "dev.search-replace.category.search"
        }
      ],
      "keybindings": [
        {
          "command": "searchReplace.show",
          "key": "Mod-f",
          "when": "editorFocus"
        },
        {
          "command": "searchReplace.showWithReplace",
          "key": "Mod-h",
          "when": "editorFocus"
        },
        {
          "command": "searchReplace.hide",
          "key": "Escape",
          "when": "searchReplaceVisible"
        },
        {
          "command": "searchReplace.next",
          "key": "Enter",
          "when": "searchReplaceVisible"
        },
        {
          "command": "searchReplace.prev",
          "key": "Shift-Enter",
          "when": "searchReplaceVisible"
        },
        {
          "command": "searchReplace.selectAll",
          "key": "Alt-Enter",
          "when": "searchReplaceVisible"
        }
      ]
    },
    "activationEvents": [
      "onStartupFinished"
    ],
    "engines": {
      "zion": ">=1.0.0"
    },
    "nameKey": "dev.plugins.pluginName.dev.search-replace",
    "descriptionKey": "dev.plugins.pluginDescription.dev.search-replace"
  }
}
