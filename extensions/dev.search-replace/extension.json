{
  "name": "dev.search-replace",
  "version": "0.1.0",
  "main": "./main.js",
  "contributes": {
    "commands": [
      { "id": "searchReplace.show", "title": "Show Search" },
      { "id": "searchReplace.showWithReplace", "title": "Show Search and Replace" },
      { "id": "searchReplace.hide", "title": "Hide Search" },
      { "id": "searchReplace.next", "title": "Next Match" },
      { "id": "searchReplace.prev", "title": "Previous Match" },
      { "id": "searchReplace.selectAll", "title": "Select All Matches" },
      { "id": "searchReplace.replace", "title": "Replace Current Match" },
      { "id": "searchReplace.replaceAll", "title": "Replace All Matches" }
    ],
    "keybindings": [
      { "command": "searchReplace.show", "key": "Mod-f", "when": "editorFocus" },
      { "command": "searchReplace.showWithReplace", "key": "Mod-h", "when": "editorFocus" },
      { "command": "searchReplace.hide", "key": "Escape", "when": "searchReplaceVisible" },
      { "command": "searchReplace.next", "key": "Enter", "when": "searchReplaceVisible" },
      { "command": "searchReplace.prev", "key": "Shift-Enter", "when": "searchReplaceVisible" },
      { "command": "searchReplace.selectAll", "key": "Alt-Enter", "when": "searchReplaceVisible" }
    ]
  },
  "activationEvents": ["onStartupFinished"]
}