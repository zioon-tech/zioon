{
  "name": "dev.task-panel",
  "version": "0.0.1",
  "description": "Zion Next Plugin: dev.task-panel",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.task-panel",
    "name": "dev.task-panel",
    "version": "0.0.1",
    "main": "./main.js",
    "contributes": {
      "commands": [
        {
          "id": "tasks.togglePanel",
          "title": "Toggle Tasks Panel",
          "titleKey": "dev.task-panel.cmd.togglePanel",
          "categoryKey": "dev.task-panel.category.tasks"
        },
        {
          "id": "tasks.addTask",
          "title": "Add Task",
          "titleKey": "dev.task-panel.cmd.addTask",
          "categoryKey": "dev.task-panel.category.tasks"
        },
        {
          "id": "tasks.clearTasks",
          "title": "Clear All Tasks",
          "titleKey": "dev.task-panel.cmd.clearTasks",
          "categoryKey": "dev.task-panel.category.tasks"
        }
      ]
    },
    "activationEvents": [
      "onStartupFinished"
    ],
    "engines": {
      "zion": ">=1.0.0"
    }
  }
}
