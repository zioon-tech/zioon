        {
          "id": "imageEnhancer.showImageInfo",
          "title": "图片增强: 显示图片信息",
          "titleKey": "dev.image-enhanced.cmd.showImageInfo",
          "categoryKey": "dev.image-enhanced.category.image"
        }
