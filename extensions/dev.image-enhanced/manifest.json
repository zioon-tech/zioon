        {
          "id": "imageEnhancer.openInNewTab",
          "title": "图片增强: 在新标签页打开图片",
          "titleKey": "dev.image-enhanced.cmd.openInNewTab",
          "categoryKey": "dev.image-enhanced.category.image"
