{
  "name": "dev.image-enhanced",
  "version": "0.0.1",
  "description": "Enhance markdown images with an in-editor toolbar (open/copy/delete).",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.image-enhanced",
    "name": "dev.image-enhanced",
    "nameKey": "dev.plugins.pluginName.dev.image-enhanced",
    "descriptionKey": "dev.plugins.pluginDescription.dev.image-enhanced",
    "version": "0.0.1",
    "main": "./main.js",
    "contributes": {
      "commands": [
        {
          "id": "imageEnhancer.copyImage",
          "title": "图片增强: 复制图片到剪贴板",
          "titleKey": "dev.image-enhanced.cmd.copyImage",
          "categoryKey": "dev.image-enhanced.category.image"
        },
        {
          "id": "imageEnhancer.downloadImage",
          "title": "图片增强: 下载图片",
          "titleKey": "dev.image-enhanced.cmd.downloadImage",
          "categoryKey": "dev.image-enhanced.category.image"
