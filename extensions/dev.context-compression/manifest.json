{
  "name": "dev.context-compression",
  "version": "0.0.1",
  "description": "Provide multi-strategy context compression and statistics for AI conversations.",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.context-compression",
    "name": "Context Compression",
    "version": "0.0.1",
    "main": "./main.js",
    "entries": {
      "ui": "./main.js",
      "runtime": "./runtime.js"
    },
    "runtime": {
      "apiVersion": 2
    },
    "presentation": {
      "displayName": {
        "zh-CN": "上下文压缩",
        "en-US": "Context Compression"
      },
      "description": {
        "zh-CN": "为 AI 对话提供多策略上下文压缩和统计。",
        "en-US": "Provide multi-strategy context compression and statistics for AI conversations."
      },
      "icon": "fold",
      "category": "ai",
      "features": {
        "zh-CN": [
          "为 AI 对话提供多策略上下文压缩和统计。"
        ],
        "en-US": [
          "Provide multi-strategy context compression and statistics for AI conversations."
        ]
      }
    },
    "contributes": {
      "commands": [
        {
          "id": "compression.manual",
          "title": "Compress Conversation (Manual)",
          "titleKey": "dev.context-compression.cmd.manual",
          "categoryKey": "dev.context-compression.category.compression"
        },
        {
          "id": "compression.strategy.opencode",
          "title": "Compress with OpenCode Strategy",
          "titleKey": "dev.context-compression.cmd.strategy.opencode",
          "categoryKey": "dev.context-compression.category.compression"
        },
        {
          "id": "compression.strategy.claude-code",
          "title": "Compress with Claude Code Strategy",
          "titleKey": "dev.context-compression.cmd.strategy.claudeCode",
          "categoryKey": "dev.context-compression.category.compression"
        },
        {
          "id": "compression.strategy.cursor",
          "title": "Compress with Cursor Strategy",
          "titleKey": "dev.context-compression.cmd.strategy.cursor",
          "categoryKey": "dev.context-compression.category.compression"
        },
        {
          "id": "compression.strategy.manus",
          "title": "Compress with Manus Strategy",
          "titleKey": "dev.context-compression.cmd.strategy.manus",
          "categoryKey": "dev.context-compression.category.compression"
        },
        {
          "id": "compression.strategy.focus-agent",
          "title": "Compress with Focus Agent Strategy",
          "titleKey": "dev.context-compression.cmd.strategy.focusAgent",
          "categoryKey": "dev.context-compression.category.compression"
        },
        {
          "id": "compression.settings",
          "title": "Open Compression Settings",
          "titleKey": "dev.context-compression.cmd.settings",
          "categoryKey": "dev.context-compression.category.compression"
        },
        {
          "id": "compression.stats",
          "title": "Show Compression Statistics",
          "titleKey": "dev.context-compression.cmd.stats",
          "categoryKey": "dev.context-compression.category.compression"
        }
      ],
      "keybindings": [
        {
          "command": "compression.manual",
          "key": "Mod-Shift-c",
          "when": "editorFocus"
        },
        {
          "command": "compression.settings",
          "key": "Mod-Shift-s",
          "when": "editorFocus"
        }
      ],
      "menus": {
        "editor/context": [
          {
            "command": "compression.manual",
            "title": "Compress Conversation",
            "when": "editorFocus",
            "titleKey": "dev.context-compression.cmd.manual"
          },
          {
            "command": "compression.settings",
            "title": "Compression Settings",
            "when": "editorFocus",
            "titleKey": "dev.context-compression.cmd.settings"
          }
        ]
      },
      "views": {
        "status-bar/compression": {
          "type": "status-bar-item",
          "title": "Compression",
          "titleKey": "dev.context-compression.settings.title"
        }
      }
    },
    "activationEvents": [
      "onStartupFinished",
      "onCommand:compression.manual",
      "onCommand:compression.settings",
      "onCommand:compression.stats"
    ],
    "engines": {
      "zion": ">=1.0.0"
    },
    "nameKey": "dev.plugins.pluginName.dev.context-compression",
    "descriptionKey": "dev.plugins.pluginDescription.dev.context-compression"
  }
}
