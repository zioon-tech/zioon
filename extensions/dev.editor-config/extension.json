{
  "name": "dev.editor-config",
  "version": "0.0.1",
  "main": "./main.js",
  "contributes": {
    "commands": [
      { "id": "dev.editor.toggleLineNumbers", "title": "Toggle Line Numbers" },
      { "id": "dev.editor.toggleActiveLineHighlight", "title": "Toggle Active Line Highlight" },
      { "id": "dev.editor.toggleSyntaxHighlight", "title": "Toggle Syntax Highlight" },
      { "id": "dev.editor.toggleAutoIndent", "title": "Toggle Auto Indent" },
      { "id": "dev.editor.toggleFolding", "title": "Toggle Folding" },
      { "id": "dev.editor.toggleLineWrap", "title": "Toggle Line Wrap" },
      { "id": "dev.editor.toggleSelectionHighlight", "title": "Toggle Selection Highlight" },

      { "id": "dev.editor.cycleWidthMode", "title": "Cycle Editor Width Mode" },
      { "id": "dev.editor.setWidthFull", "title": "Set Editor Width: Full" },
      { "id": "dev.editor.setWidthWide", "title": "Set Editor Width: Wide" },
      { "id": "dev.editor.setWidthStandard", "title": "Set Editor Width: Standard" },

      { "id": "dev.editor.setHeadingSizeMedium", "title": "Set Heading Size: Medium" },
      { "id": "dev.editor.setHeadingSizeSmall", "title": "Set Heading Size: Small" },
      { "id": "dev.editor.setHeadingSizeXSmall", "title": "Set Heading Size: XSmall" },
      { "id": "dev.editor.cycleHeadingSize", "title": "Cycle Heading Size" }
    ],
    "keybindings": [
      { "command": "dev.editor.toggleLineNumbers", "key": "Mod-Shift-L", "when": "editorFocus" },
      { "command": "dev.editor.toggleSyntaxHighlight", "key": "Mod-Shift-S", "when": "editorFocus" },
      { "command": "dev.editor.toggleAutoIndent", "key": "Mod-Shift-I", "when": "editorFocus" },
      { "command": "dev.editor.toggleActiveLineHighlight", "key": "Mod-Shift-H", "when": "editorFocus" },
      { "command": "dev.editor.toggleFolding", "key": "Mod-Shift-F", "when": "editorFocus" },
      { "command": "dev.editor.toggleLineWrap", "key": "Mod-Shift-W", "when": "editorFocus" },

      { "command": "dev.editor.cycleWidthMode", "key": "Mod-Shift-B", "when": "editorFocus" },
      { "command": "dev.editor.toggleSelectionHighlight", "key": "Mod-Shift-M", "when": "editorFocus" }
    ]
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:dev.editor.toggleLineNumbers",
    "onCommand:dev.editor.cycleWidthMode",
    "onCommand:dev.editor.setWidthFull",
    "onCommand:dev.editor.setWidthWide",
    "onCommand:dev.editor.setWidthStandard",

    "onCommand:dev.editor.setHeadingSizeMedium",
    "onCommand:dev.editor.setHeadingSizeSmall",
    "onCommand:dev.editor.setHeadingSizeXSmall",
    "onCommand:dev.editor.cycleHeadingSize",
    "onCommand:dev.editor.toggleSelectionHighlight"
  ]
}