{
  "name": "dev.editor-config",
  "version": "0.0.1",
  "description": "Zion Next Plugin: dev.editor-config",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.editor-config",
    "name": "dev.editor-config",
    "version": "0.0.1",
    "main": "./main.js",
    "contributes": {
      "commands": [
        {
          "id": "dev.editor.toggleLineNumbers",
          "title": "Toggle Line Numbers",
          "titleKey": "dev.editor-config.cmd.toggleLineNumbers",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.toggleActiveLineHighlight",
          "title": "Toggle Active Line Highlight",
          "titleKey": "dev.editor-config.cmd.toggleActiveLineHighlight",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.toggleSyntaxHighlight",
          "title": "Toggle Syntax Highlight",
          "titleKey": "dev.editor-config.cmd.toggleSyntaxHighlight",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.toggleAutoIndent",
          "title": "Toggle Auto Indent",
          "titleKey": "dev.editor-config.cmd.toggleAutoIndent",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.toggleFolding",
          "title": "Toggle Folding",
          "titleKey": "dev.editor-config.cmd.toggleFolding",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.toggleLineWrap",
          "title": "Toggle Line Wrap",
          "titleKey": "dev.editor-config.cmd.toggleLineWrap",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.toggleSelectionHighlight",
          "title": "Toggle Selection Highlight",
          "titleKey": "dev.editor-config.cmd.toggleSelectionHighlight",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.cycleWidthMode",
          "title": "Cycle Editor Width Mode",
          "titleKey": "dev.editor-config.cmd.cycleWidthMode",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.setWidthFull",
          "title": "Set Editor Width: Full",
          "titleKey": "dev.editor-config.cmd.setWidthFull",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.setWidthWide",
          "title": "Set Editor Width: Wide",
          "titleKey": "dev.editor-config.cmd.setWidthWide",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.setWidthStandard",
          "title": "Set Editor Width: Standard",
          "titleKey": "dev.editor-config.cmd.setWidthStandard",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.setHeadingSizeMedium",
          "title": "Set Heading Size: Medium",
          "titleKey": "dev.editor-config.cmd.setHeadingSizeMedium",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.setHeadingSizeSmall",
          "title": "Set Heading Size: Small",
          "titleKey": "dev.editor-config.cmd.setHeadingSizeSmall",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.setHeadingSizeXSmall",
          "title": "Set Heading Size: XSmall",
          "titleKey": "dev.editor-config.cmd.setHeadingSizeXSmall",
          "categoryKey": "dev.editor-config.category.editor"
        },
        {
          "id": "dev.editor.cycleHeadingSize",
          "title": "Cycle Heading Size",
          "titleKey": "dev.editor-config.cmd.cycleHeadingSize",
          "categoryKey": "dev.editor-config.category.editor"
        }
      ],
      "keybindings": [
        {
          "command": "dev.editor.toggleLineNumbers",
          "key": "Mod-Shift-L",
          "when": "editorFocus"
        },
        {
          "command": "dev.editor.toggleSyntaxHighlight",
          "key": "Mod-Shift-S",
          "when": "editorFocus"
        },
        {
          "command": "dev.editor.toggleAutoIndent",
          "key": "Mod-Shift-I",
          "when": "editorFocus"
        },
        {
          "command": "dev.editor.toggleActiveLineHighlight",
          "key": "Mod-Shift-H",
          "when": "editorFocus"
        },
        {
          "command": "dev.editor.toggleFolding",
          "key": "Mod-Shift-F",
          "when": "editorFocus"
        },
        {
          "command": "dev.editor.toggleLineWrap",
          "key": "Mod-Shift-W",
          "when": "editorFocus"
        },
        {
          "command": "dev.editor.cycleWidthMode",
          "key": "Mod-Shift-B",
          "when": "editorFocus"
        },
        {
          "command": "dev.editor.toggleSelectionHighlight",
          "key": "Mod-Shift-M",
          "when": "editorFocus"
        }
      ]
    },
    "activationEvents": [
      "onStartupFinished",
      "onCommand:dev.editor.toggleLineNumbers",
      "onCommand:dev.editor.cycleWidthMode",
      "onCommand:dev.editor.setWidthFull",
      "onCommand:dev.editor.setWidthWide",
      "onCommand:dev.editor.setWidthStandard",
      "onCommand:dev.editor.setHeadingSizeMedium",
      "onCommand:dev.editor.setHeadingSizeSmall",
      "onCommand:dev.editor.setHeadingSizeXSmall",
      "onCommand:dev.editor.cycleHeadingSize",
      "onCommand:dev.editor.toggleSelectionHighlight"
    ],
    "engines": {
      "zion": ">=1.0.0"
    }
  }
}
