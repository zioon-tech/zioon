{
  "name": "dev.langchain-chat",
  "version": "0.0.1",
  "description": "Zion Next Plugin: dev.langchain-chat",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.langchain-chat",
    "name": "dev.langchain-chat",
    "version": "0.0.1",
    "main": "./main.js",
    "contributes": {
      "commands": [
        {
          "id": "chat.runSelection",
          "title": "Run Chat (Selection)",
          "titleKey": "dev.langchain-chat.cmd.runSelection",
          "categoryKey": "dev.langchain-chat.category.chat"
        },
        {
          "id": "chat.run",
          "title": "Run Chat",
          "titleKey": "dev.langchain-chat.cmd.run",
          "categoryKey": "dev.langchain-chat.category.chat"
        },
        {
          "id": "chat.stop",
          "title": "Stop Chat",
          "titleKey": "dev.langchain-chat.cmd.stop",
          "categoryKey": "dev.langchain-chat.category.chat"
        },
        {
          "id": "chat.retry",
          "title": "Retry Chat",
          "titleKey": "dev.langchain-chat.cmd.retry",
          "categoryKey": "dev.langchain-chat.category.chat"
        }
      ],
      "keybindings": [
        {
          "command": "chat.runSelection",
          "key": "Mod-Enter",
          "when": "editorFocus"
        },
        {
          "command": "chat.stop",
          "key": "Escape",
          "when": "editorFocus"
        },
        {
          "command": "chat.retry",
          "key": "Mod-Shift-r",
          "when": "editorFocus"
        }
      ]
    },
    "activationEvents": [
      "onStartupFinished"
    ],
    "engines": {
      "zion": ">=1.0.0"
    }
  }
}
