{
  "name": "dev.toc",
  "version": "0.0.1",
  "description": "Zion Next Plugin: dev.toc",
  "author": "Zion Developer",
  "license": "MIT",
  "zion": {
    "id": "dev.toc",
    "name": "dev.toc",
    "version": "0.0.1",
    "main": "./main.js",
    "contributes": {
      "commands": [
        {
          "id": "toc.show",
          "title": "Show TOC",
          "titleKey": "dev.toc.cmd.show",
          "categoryKey": "dev.toc.category.toc"
        },
        {
          "id": "toc.insert",
          "title": "Insert TOC (Markdown)",
          "titleKey": "dev.toc.cmd.insert",
          "categoryKey": "dev.toc.category.toc"
        },
        {
          "id": "toc.toggleGroupByRole",
          "title": "Toggle TOC Group by Role",
          "titleKey": "dev.toc.cmd.toggleGroupByRole",
          "categoryKey": "dev.toc.category.toc"
        }
      ],
      "keybindings": [
        {
          "command": "toc.show",
          "key": "Mod-Shift-t",
          "when": "editorFocus"
        },
        {
          "command": "toc.toggleGroupByRole",
          "key": "Mod-Shift-g",
          "when": "editorFocus"
        }
      ],
      "menus": {
        "editor/context": [
          {
            "command": "toc.show",
            "title": "Contents",
            "titleKey": "dev.toc.menu.contents",
            "when": "editorFocus"
          },
          {
            "command": "toc.toggleGroupByRole",
            "title": "TOC: Group by Role",
            "titleKey": "dev.toc.menu.groupByRole",
            "when": "editorFocus"
          }
        ]
      }
    },
    "activationEvents": [
      "onStartupFinished",
      "onCommand:toc.show",
      "onCommand:toc.insert",
      "onCommand:toc.toggleGroupByRole"
    ],
    "engines": {
      "zion": ">=1.0.0"
    }
  }
}
