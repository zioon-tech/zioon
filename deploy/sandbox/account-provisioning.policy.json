{
  "Version": "1",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "nas:CreateAgenticSpace",
        "nas:DescribeAgenticSpaces"
      ],
      "Resource": "acs:nas:cn-shanghai:1803625616810276:filesystem/030pngfn34jnuh0y0mx"
    },
    {
      "Effect": "Allow",
      "Action": [
        "nas:GetAgenticSpace",
        "nas:CreateAccessPoint",
        "nas:DescribeAccessPoint",
        "nas:ListAccessPoints"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": ["ram:CreateRole", "ram:GetRole", "ram:ListPoliciesForRole", "ram:PassRole"],
