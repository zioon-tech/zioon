        "acs:ram:*:1803625616810276:role/ZionManaged*",
        "acs:ram:*:1803625616810276:role/zionmanaged*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": ["ram:CreatePolicy", "ram:GetPolicy", "ram:GetPolicyVersion"],
      "Resource": "acs:ram:*:1803625616810276:policy/ZionManaged*"
    },
    {
      "Effect": "Allow",
      "Action": ["ram:AttachPolicyToRole"],
      "Resource": [
        "acs:ram:*:1803625616810276:role/ZionManaged*",
        "acs:ram:*:1803625616810276:role/zionmanaged*",
        "acs:ram:*:1803625616810276:policy/ZionManaged*"
      ]
    }
  ]
}
