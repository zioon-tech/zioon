[Unit]
Description=Zion Cloud Plugin Host
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zion-worker
Group=zion-worker
WorkingDirectory=/srv/zion-workspaces/zion-next
Environment=HOME=/home/zion-worker
Environment=PYTHONUNBUFFERED=1
Environment=ZION_PLUGIN_HOST=127.0.0.1
Environment=ZION_PLUGIN_PORT=8767
Environment=ZION_PLUGIN_RELOAD=0
Environment=ZION_REDIS_ENABLED=0
ExecStart=/opt/zion-local-tools/.venv/bin/python /opt/zion-local-tools/run_plugin_host.py
Restart=always
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/zion-worker /srv/zion-workspaces
InaccessiblePaths=-/var/lib/zion-next -/etc/zion-next -/var/lib/caddy -/etc/caddy
RestrictSUIDSGID=true
UMask=0077

[Install]
WantedBy=multi-user.target
