NODE_ENV=production
ZION_RUNTIME_ACCESS_CONTROL=1
ZION_RUNTIME_PUBLIC_URL=https://runtime.example.com
ZION_RUNTIME_ALLOWED_ORIGINS=https://runtime.example.com
ZION_RUNTIME_TOOL_MODE=node
ZION_RUNTIME_ENGINE=openai
ZION_RUNTIME_EXTERNAL_PLUGIN_ROOT=/var/lib/zion-next/plugins
ZION_RUNTIME_EXTERNAL_PLUGINS=dev.identity
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
OTEL_SERVICE_NAME=zion-runtime
ZION_DEPLOYMENT_ENVIRONMENT=single-user-pilot
ZION_OBSERVABILITY_QUERY_URL=http://127.0.0.1:16686
ZION_OTEL_TRACE_URL_TEMPLATE=https://runtime.example.com/observability/trace/{traceId}
