NODE_ENV=production
ZION_DATABASE_URL=postgresql://zion:REDACTED@127.0.0.1:5432/zion
ZION_SPACE_ID=space:production
ZION_RUNTIME_AUTH_MODE=accounts
ZION_OIDC_ISSUER=https://runtime.example.com/idp
ZION_OIDC_CLIENT_ID=zion-runtime
ZION_OIDC_CLIENT_SECRET=REDACTED
ZION_OIDC_API_AUDIENCE=
ZION_OIDC_API_SCOPE=zion.api
ZION_LOCAL_IDENTITY_HOST=127.0.0.1
ZION_LOCAL_IDENTITY_PORT=18080
ZION_RUNTIME_ACCESS_CONTROL=1
ZION_RUNTIME_PUBLIC_URL=https://runtime.example.com
ZION_RUNTIME_ALLOWED_ORIGINS=https://runtime.example.com
ZION_RUNTIME_TOOL_MODE=node
ZION_ACCOUNT_ALLOW_RESOURCE_EXECUTION=1
ZION_ALLOW_DANGEROUS=1
ZION_RUNTIME_ENGINE=openai
ZION_RUNTIME_ASSET_MAX_IMAGE_BYTES=16MiB
ZION_RUNTIME_MODEL_REQUEST_DETAIL_MAX_BYTES=8MiB
ZION_RUNTIME_MODEL_REQUEST_DETAIL_MAX_ROWS=2000
ZION_RUNTIME_MODEL_REQUEST_DETAIL_MAX_STORED_BYTES=256MiB
ZION_RUNTIME_MODEL_REQUEST_DETAIL_RETENTION_DAYS=30
ZION_RUNTIME_EXTERNAL_PLUGIN_ROOT=/var/lib/zion-next/plugins
ZION_RUNTIME_EXTERNAL_PLUGINS=dev.identity
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1
OTEL_SERVICE_NAME=zion-runtime
ZION_DEPLOYMENT_ENVIRONMENT=single-user-pilot
ZION_OBSERVABILITY_QUERY_URL=http://127.0.0.1:16686
ZION_OTEL_TRACE_URL_TEMPLATE=https://runtime.example.com/observability/trace/{traceId}
