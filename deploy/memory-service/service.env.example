# Non-secret settings; Bun 1.4.1 and the pinned upstream checkout are required.
AGENT_FS_UPSTREAM_DIR=/opt/agent-fs
AGENT_FS_HOME=/var/lib/zion-memory
AGENT_FS_STORAGE_PROVIDER=oss
ZION_MEMORY_HOST=127.0.0.1
ZION_MEMORY_PORT=18991
ZION_ACCOUNT_RUNTIME_URL=http://127.0.0.1:8766
ZION_MEMORY_BRIDGE_SECRET_FILE=/etc/zion-memory/bridge.key
ZION_MEMORY_ALLOWED_ORIGINS=https://runtime.zioon.tech
OSS_BUCKET=YOUR_PRIVATE_MEMORY_BUCKET
OSS_REGION=oss-cn-shanghai
OSS_ENDPOINT=https://oss-cn-shanghai.aliyuncs.com
DO_NOT_TRACK=1
ANONYMIZED_TELEMETRY=false

# Credentials belong in transient /run/zion-memory/oss.env or a secrets injector.
# Names only: OSS_ACCESS_KEY_ID, OSS_ACCESS_KEY_SECRET, optional OSS_STS_TOKEN.
# STS credentials expire. Renew the injected file and restart the service;
# automatic STS renewal is not implemented in this pilot.
#
# Add to the existing Runtime's environment after data copy and validation:
# ZION_MEMORY_SERVICE_URL=http://127.0.0.1:18991
# ZION_MEMORY_PUBLIC_URL=https://memory.zioon.tech
# ZION_MEMORY_BRIDGE_SECRET_FILE=/etc/zion-memory/bridge.key
# dev.identity has no plugin-data fallback.
